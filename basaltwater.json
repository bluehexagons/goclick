{
  "version": 1,
  "components": [
    {
      "name": "server",
      "type": "service",
      "domain": "{{domain}}",
      "build": "mkdir -p .basaltwater/bin && go build -trimpath -ldflags='-s -w' -o .basaltwater/bin/goclick ./cmd/server && go build -trimpath -ldflags='-s -w' -o .basaltwater/bin/migrate-rails ./cmd/migrate-rails",
      "binary": ".basaltwater/bin/goclick",
      "port": "auto",
      "runtime_env": {
        "GOCLICK_ADDR": "127.0.0.1:{{port}}",
        "GOCLICK_DATABASE": "{{data_dir}}/goclick.db",
        "GOCLICK_SECURE_COOKIES": "true",
        "GOCLICK_TRUST_PROXY": "true"
      },
      "health": "/up",
      "sqlite_backup": "{{data_dir}}/goclick.db",
      "backup_retention": 14
    }
  ]
}
