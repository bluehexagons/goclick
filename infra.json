{
  "version": 1,
  "components": [
    {
      "name": "server",
      "type": "service",
      "domain": "{{domain}}",
      "build": "mkdir -p .infra_tools/bin && go build -trimpath -ldflags='-s -w' -o .infra_tools/bin/goclick ./cmd/server",
      "binary": ".infra_tools/bin/goclick",
      "port": 8080,
      "runtime_env": {
        "GOCLICK_ADDR": "127.0.0.1:{{port}}",
        "GOCLICK_DATABASE": "{{data_dir}}/goclick.db",
        "GOCLICK_SECURE_COOKIES": "true"
      },
      "health": "/up"
    }
  ]
}
